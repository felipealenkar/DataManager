unit GerenciadorBackup;

interface

uses
  FireDAC.Phys.PG, FireDAC.Phys.PGDef, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, Data.DB, FireDAC.Phys, FireDAC.VCLUI.Wait,
  FireDAC.Comp.Client, FireDAC.Stan.Param, FireDAC.DatS, FireDAC.DApt.Intf, FireDAC.DApt, FireDAC.Comp.DataSet;

type
  TEnumAcao = (Conectar, Desconectar, Criar, Dropar, Adicionar, Remover, Renomear, Backup, Restore);

  TGerenciadorBackup = class (TObject)
    private
      FConnection: TFDConnection;
    public
      Driver: string;
      Server: string;
      Porta: string;
      Usuario: string;
      Biblioteca: string;
      Dump: string;
      Restore: string;
      Database:String;
      OwnerPadrao: string;
      Senha: string;
      Extensao: string;
      TipoQueryDlg: string;
      VersaoMinima: currency;

    constructor Create;
    destructor Destroy; override;
    procedure DefinirParametros(PNomeDoDriverDB, PServer, PPorta, PUsuario,
      PBiblioteca, PDump, PRestore, PDatabase, POwnerPadrao, PSenha, PExtensao,
      PTipoQueryDlg: String; PVersaoMinima: Currency);
    procedure ConectarDesconectarDriverDoDatabase(PNomeDoDatabase: string; PAcao: TEnumAcao);
  end;

implementation

uses
  Funcoes;

constructor TGerenciadorBackup.Create;
begin
  FConnection := TFDConnection.Create(nil);
end;

procedure TGerenciadorBackup.DefinirParametros(PNomeDoDriverDB, PServer, PPorta, PUsuario, PBiblioteca, PDump, PRestore,
                                               PDatabase, POwnerPadrao, PSenha, PExtensao, PTipoQueryDlg: String; PVersaoMinima: Currency);
// Método que recebe os parâmetros e atribúi na classe.
begin
  Server := PServer;
  Usuario := PUsuario;
  Senha := PSenha;
  Porta := PPorta;
  OwnerPadrao := POwnerPadrao;
  Extensao := 'postgresql';
  TipoQueryDlg := 'Backup PostgreSQL';
  VersaoMinima := PVersaoMinima;

  if PNomeDoDriverDB = 'Firebird 5.0' then
    begin
       Driver := 'FB';
       Biblioteca := 'C:\Program Files\Firebird\Firebird_5_0\fbclient.dll';
    end
  else if (PNomeDoDriverDB = 'PostgreSQL 17') then
    begin
      Driver := 'PG';
      Biblioteca := 'C:\Program Files\PostgreSQL\17\bin\libpq.dll';
      Dump := 'C:\Program Files\PostgreSQL\17\bin\pg_dump.exe';
      Restore := 'C:\Program Files\PostgreSQL\17\bin\pg_restore.exe';
    end;
  RegistrarLogs('TDriverBDConexao.DefineParametros', 'Parâmetros de conexão definidos.');
end;


destructor TGerenciadorBackup.Destroy;
begin
  FConnection.Free;
  inherited;
end;

procedure TGerenciadorBackup.ConectarDesconectarDriverDoDatabase(PNomeDoDatabase: string; PAcao: TEnumAcao);
// Inicia ou encerra a conexão com o BD Selecionado
// PostgreSQL password #abc123#
Var
  TipoLog1, VersaoCompleta: string;
begin
  case PAcao of
    Conectar:
      begin
        FConnection.close;
        FDConnectionDB.Params.Clear;
        FDConnectionDB.DriverName := FGerenciadorBackup.Driver;
        FDPhysPgDriverLinkBD.VendorLib := FGerenciadorBackup.Biblioteca;
        FDConnectionDB.Params.Values['Server'] := FGerenciadorBackup.Server;
        FDConnectionDB.Params.Values['Port'] := FGerenciadorBackup.Porta;
        FDConnectionDB.Params.Values['User_Name'] := FGerenciadorBackup.Usuario;
        FDConnectionDB.Params.Values['Password'] := FGerenciadorBackup.Senha;
        FDConnectionDB.Params.Values['Database'] := PNomeDoDatabase;
        FDConnectionDB.Params.Values['CharacterSet'] := 'UTF8';
        FDConnectionDB.LoginPrompt := False;
        FDConnectionDB.Params.Values['SSLMode'] := 'disable';
        FDConnectionDB.Open;
        VerificaVersaoPostgres(VersaoCompleta);
        LblDriverConectado.Caption := VersaoCompleta;
        LblDriverConectado.font.Color := ClBlue;
        TipoLog1 := 'iniciada com sucesso.';
      end;
    Desconectar:
      begin
        FDConnectionDB.close;
        TipoLog1 := 'encerrada com sucesso.';
        LblDriverConectado.Caption := 'Nenhum banco de dados conectado';
        LblDriverConectado.font.Color := ClRed;
      end;
  end;
  RegistrarLogs('TFormDataManager.ConectarDesconectarDriverDoDatabase', 'Conexão com o banco de dados "' + FDConnectionDB.DriverName + '" ' + TipoLog1);
end;

end.
