unit GerenciadorBackup;

interface

uses
  FireDAC.Phys.PG, FireDAC.Phys.PGDef, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, Data.DB, FireDAC.Phys, FireDAC.VCLUI.Wait,
  FireDAC.Comp.Client, FireDAC.Stan.Param, FireDAC.DatS, FireDAC.DApt.Intf, FireDAC.DApt, FireDAC.Comp.DataSet,

  System.SysUtils, Vcl.Dialogs, Vcl.StdCtrls;

type
  TEnumAcao = (Conectar, Desconectar, Criar, Dropar, Adicionar, Remover, Renomear, Backup, Restaurar);

  TGerenciadorBackup = class (TObject)
    private
      FPgDriver: TFDPhysPgDriverLink;
      FConnection: TFDConnection;
      FQuery: TFDQuery;
    public
      Driver: string;
      Server: string;
      Porta: string;
      Usuario: string;
      Biblioteca: string;
      Dump: string;
      Restore: string;
      Database:String;
      OwnerPadrao: string;
      Senha: string;
      Extensao: string;
      TipoQueryDlg: string;
      VersaoMinima: currency;

    constructor Create;
    destructor Destroy; override;

    procedure AdicionarOuRemoverPermissoesNosRoles(PNomeDoDatabase: string; PAcao: TEnumAcao);
    procedure AtualizarListaBancos(PStatusConexao: Boolean; PLbxDatabases: TListBox);
    function CapturarNomeDoDatabase(PNomeDoDatabase: string; PAcao: TEnumAcao; out PDigitou: boolean): string;
    procedure ConectarDesconectar(PAcao: TEnumAcao; PNomeDoDriverDB, PServer, PPorta, PUsuario, PBiblioteca,
              PDump, PRestore, PDatabase, POwnerPadrao, PSenha, PExtensao, PTipoQueryDlg: String; PVersaoMinima: Currency);
    function CriarComando(PAcao: TEnumAcao; POutputFile, PDumpPath,
      PRestorePath, PHost, PPorta, PNomeDoDatabase, PSenha: string): string;
    procedure CriarNovoDatabase;
    procedure CriarDroparDataBase(PNomeDoDatabase: string; PAcao: TEnumAcao);
    procedure CriarDroparRoles(PNomeDoDatabase: string; PAcao: TEnumAcao);
    procedure DefinirParametros(PNomeDoDriverDB, PServer, PPorta, PUsuario, PBiblioteca, PDump, PRestore, PDatabase,
                                POwnerPadrao, PSenha, PExtensao, PTipoQueryDlg: String; PVersaoMinima: Currency);
    function ValidarExisteDatabase(PNomeDoDatabase: String; PLbxDatabases: TListBox): boolean;
    function VerificarVersaoPostgres(out PVersaoCompleta:string): Currency;


end;

implementation

uses
  Funcoes;

procedure TGerenciadorBackup.AdicionarOuRemoverPermissoesNosRoles(PNomeDoDatabase: string; PAcao: TEnumAcao);
// Atribúi permissão nos roles
Var
  Sucesso: integer;
  TipoLog1 : string;
begin
  Sucesso := 0;
  try
    FQuery.close;
    FDQueryBD.sql.Clear;
    case PAcao of
      Adicionar: FDQueryBD.sql.Add('GRANT CONNECT, TEMPORARY ON DATABASE "' + PNomeDoDatabase + '" TO public');
      Remover: FDQueryBD.sql.Add('REVOKE CONNECT, TEMPORARY ON DATABASE "' + PNomeDoDatabase + '" FROM public');
    end;
    FDQueryBD.ExecSQL;
    FDQueryBD.close;
    FDQueryBD.sql.Clear;
    Inc(Sucesso);
  Except
  end;

  try
    case PAcao of
    Adicionar: FDQueryBD.sql.Add('GRANT ALL ON DATABASE "' + PNomeDoDatabase + '" TO "' + FGerenciadorBackup.OwnerPadrao + '"');
    Remover: FDQueryBD.sql.Add('REVOKE ALL ON DATABASE "' + PNomeDoDatabase + '" FROM "' + FGerenciadorBackup.OwnerPadrao + '"');
    end;
    FDQueryBD.ExecSQL;
    FDQueryBD.close;
    FDQueryBD.sql.Clear;
    Inc(Sucesso);
  Except
  end;

  try
    case PAcao of
      Adicionar:
        begin
          FDQueryBD.sql.Add('GRANT ALL ON DATABASE "' + PNomeDoDatabase + '" TO "PRODFAB_GROUP_' + PNomeDoDatabase + '"');
          TipoLog1 := 'adicionadas aos';
        end;
      Remover:
        begin
          FDQueryBD.sql.Add('REVOKE ALL ON DATABASE "' + PNomeDoDatabase + '" FROM "PRODFAB_GROUP_' + PNomeDoDatabase + '"');
          TipoLog1 := 'removidas dos';
        end;
    end;
    FDQueryBD.ExecSQL;
    FDQueryBD.close;
    FDQueryBD.sql.Clear;
    Inc(Sucesso);
  Except
  end;
  if Sucesso = 3 then
    RegistrarLogs('TFormDataManager.AdicionarOuRemoverPermissoesNosRoles', 'Permissões ' + TipoLog1 + ' usuários do database "' + PNomeDoDatabase + '".')
  else if Sucesso > 0 then
    RegistrarLogs('TFormDataManager.AdicionarOuRemoverPermissoesNosRoles', 'Algumas permissões não foram atribuídas pois já existiam.')
  else
    RegistrarLogs('TFormDataManager.AdicionarOuRemoverPermissoesNosRoles', 'As permissões não puderam ser ' + TipoLog1 + ' usuários do database "' + PNomeDoDatabase + '".');
end;

procedure TGerenciadorBackup.AtualizarListaBancos(PStatusConexao: Boolean; PLbxDatabases: TListBox);
//Atualiza a grid dos bancos de dados
begin
  case PStatusConexao of
    True:
      Begin
        FQuery.SQL.text := 'select datname from pg_database where datistemplate = false and datname <> ''postgres'' order by datname';
        FQuery.Open;
        PLbxDatabases.Items.Clear;
        While not FQuery.Eof do
        begin
          PLbxDatabases.Items.Add(FQuery.FieldByName('Datname').Asstring);
          FQuery.Next;
        end;
      End;
    False:
      begin
        PLbxDatabases.Items.Clear;
      end;
  end;
  PLbxDatabases.ItemIndex := -1;
  RegistrarLogs('TGerenciadorBackup.AtualizaListaBancos', 'Lista de bancos de dados atualizada.');
end;

function TGerenciadorBackup.CapturarNomeDoDatabase(PNomeDoDatabase: string; PAcao: TEnumAcao; OUT PDigitou: boolean): string;
// Colhe o nome do database dejesado e o retorna
Var
  Mensagem: string;
begin
  if PAcao = Criar then
  Mensagem := 'Criação de novo database'
  else if PAcao = Renomear then
  Mensagem := 'Renomear database';

  repeat
    begin
      PDigitou := InputQuery(Mensagem, 'Digite o nome do novo banco de dados', PNomeDoDatabase);
      if PDigitou and (PNomeDoDatabase = '') then
      MessageDlg('O nome do banco de dados não pode ser vazio.', TMsgDlgType.mtWarning, [TMsgDlgBtn.mbOK], 0);
    end;
  until (not PDigitou) or (PNomeDoDatabase <> '');
  Result:= PNomeDoDatabase;
  RegistrarLogs('TGerenciadorBackup.CapturarNomeDoDatabase', 'Nome do database "' + PNomeDoDatabase +
                '" capturado - Parâmetro Out foi "' + BoolToStr(PDigitou) + '"');
end;

procedure TGerenciadorBackup.ConectarDesconectar(PAcao: TEnumAcao; PNomeDoDriverDB, PServer, PPorta, PUsuario, PBiblioteca,
                PDump, PRestore, PDatabase, POwnerPadrao, PSenha, PExtensao, PTipoQueryDlg: String; PVersaoMinima: Currency);
// Inicia ou encerra a conexão com o BD Selecionado
// PostgreSQL password #abc123#
begin
  case PAcao of
    Conectar:
      begin
        FConnection.close;
        FConnection.Params.Clear;
        FConnection.DriverName := PNomeDoDriverDB;
        FPgDriver.VendorLib := PBiblioteca;
        FConnection.Params.Values['Server'] := PServer;
        FConnection.Params.Values['Port'] := PPorta;
        FConnection.Params.Values['User_Name'] := PUsuario;
        FConnection.Params.Values['Password'] := PSenha;
        FConnection.Params.Values['Database'] := PDatabase;
        FConnection.Params.Values['CharacterSet'] := 'UTF8';
        FConnection.LoginPrompt := False;
        FConnection.Params.Values['SSLMode'] := 'disable';
        FConnection.Open;
        RegistrarLogs('TGerenciadorBackup.ConectarDesconectar', 'Banco de dados "' + FConnection.DriverName + '" conectado.');
      end;
    Desconectar:
      begin
        FConnection.close;
        RegistrarLogs('TGerenciadorBackup.ConectarDesconectar', 'Banco de dados "' + FConnection.DriverName + '" desconectado.');
      end;
  end;
end;

constructor TGerenciadorBackup.Create;
begin
  FPgDriver := TFDPhysPgDriverLink.Create(nil);
  FConnection := TFDConnection.Create(nil);
  FQuery := TFDQuery.Create(nil);
end;

function TGerenciadorBackup.CriarComando(PAcao: TEnumAcao; POutputFile, PDumpPath, PRestorePath,
                                      PHost, PPorta, PNomeDoDatabase, PSenha: string): string;
var
  DumpRestorePath: string;
begin
  Result := ''; // Default

  case PAcao of
    Backup:
      begin
        DumpRestorePath := PDumpPath;
        Result := Format('"%s" -U postgres -h %s -p %s -F c -b -v -f "%s" %s',
                         [DumpRestorePath, PHost, PPorta, POutputFile, PNomeDoDatabase]);
      end;
    Restaurar:
      begin
        DumpRestorePath := PRestorePath;
        Result := Format('"%s" -U postgres -h %s -p %s -d %s -v --no-owner --no-acl "%s"',
                           [DumpRestorePath, PHost, PPorta, PNomeDoDatabase, POutputFile]);
      end;
  end;
  RegistrarLogs('TGerenciadorBackup.CriaComando', 'Comando ' + Result + ' criado com sucesso.');
end;


procedure TGerenciadorBackup.CriarDroparDataBase(PNomeDoDatabase: string; PAcao: TEnumAcao);
// Cria databases novos
var
  TipoLog1, TipoLog2: string;
begin
  FQuery.close;
  FQuery.sql.Clear;
  case PAcao of
    Criar:
      begin
        FQuery.sql.Add('CREATE DATABASE "' + PNomeDoDatabase + '"');
        FQuery.sql.Add('WITH OWNER = "' + OwnerPadrao + '"');
        FQuery.sql.Add('ENCODING = ''UTF8''');
        FQuery.sql.Add('TABLESPACE = pg_default');
        FQuery.sql.Add('LC_COLLATE = ''Portuguese_Brazil.1252''');
        FQuery.sql.Add('LC_CTYPE = ''Portuguese_Brazil.1252''');
        FQuery.sql.Add('CONNECTION LIMIT = -1');
        TipoLog1 := 'criação';
        TipoLog2 := 'criado';
      end;
    Dropar:
      begin
        FQuery.sql.Add('DROP DATABASE "' + PNomeDoDatabase + '"');
        TipoLog1 := 'exclusão';
        TipoLog2 := 'excluído';
      end;
  end;
  FQuery.ExecSQL;
  RegistrarLogs('TFormDataManager.CriarDroparDataBase', 'Query de ' + TipoLog1 + ' de database executada:' + sLineBreak + sLineBreak + FQuery.sql.Text + sLineBreak);
  RegistrarLogs('TFormDataManager.CriarDroparDataBase', 'Database "' + PNomeDoDatabase + '" ' + TipoLog2 + ' com sucesso.');
  FQuery.close;
end;

procedure TGerenciadorBackup.CriarDroparRoles(PNomeDoDatabase: string; PAcao: TEnumAcao);
// Cria Roles para o banco de dados
Var
  TipoLog1: string;
  Sucesso: integer;
begin
  Sucesso := 0;
  FQuery.close;
  FQuery.sql.Clear;
  case PAcao of
    Criar: FQuery.sql.Add('CREATE ROLE "' + OwnerPadrao + '" LOGIN PASSWORD ''#abc123#''');
    Dropar: FQuery.sql.Add('DROP ROLE "' + OwnerPadrao + '" LOGIN PASSWORD ''#abc123#''');
  end;
  try
    FQuery.ExecSQL;
    FQuery.close;
    Inc(Sucesso);
  Except
    FQuery.close;
  END;
  FQuery.sql.Clear;

  case PAcao of
    Criar: FQuery.sql.Add('CREATE ROLE "PRODFAB_GROUP"');
    Dropar: FQuery.sql.Add('DROP ROLE "PRODFAB_GROUP"');
  end;
  TRY
    FQuery.ExecSQL;
    FQuery.close;
    Inc(Sucesso);
  Except
    FQuery.close;
  END;
  FQuery.sql.Clear;

  case PAcao of
    Criar:
      begin
        FQuery.sql.Add('CREATE ROLE "PRODFAB_GROUP_' + PNomeDoDatabase + '"');
        TipoLog1 := 'cadastrados';
      end;
    Dropar:
      begin
        FQuery.sql.Add('DROP ROLE "PRODFAB_GROUP_' + PNomeDoDatabase + '"');
        TipoLog1 := 'excluídos';
      end;
  end;
  TRY
    FQuery.ExecSQL;
    FQuery.close;
    Inc(Sucesso);
  Except
    FQuery.close;
  END;

  if Sucesso = 3 then
  RegistrarLogs('TGerenciadorBackup.CriarDroparRoles', 'Usuários padrão do database "' + PNomeDoDatabase + '" ' + TipoLog1 + ' com sucesso.')
  else if Sucesso > 0 then
  RegistrarLogs('TGerenciadorBackup.CriarDroparRoles', 'Alguns usuários padrão do database não foram ' + TipoLog1 + ', pois já existiam.')
  else
  RegistrarLogs('TGerenciadorBackup.CriarDroparRoles', 'Usuários padrão do database "' + PNomeDoDatabase + '" não puderam ser ' + TipoLog1 + '.');
end;

procedure TGerenciadorBackup.CriarNovoDatabase;
//Método que cria um novo Database
var
  NomeDoDatabase: string;
  NomeExiste: boolean;
  Digitou: boolean;
  Versao: string;
begin
  if not (VerificarVersaoPostgres(Versao) < VersaoMinima) then
  begin
    RegistrarLogs('TGerenciadorBackup.BtnAtualizarClick', 'Usuário clicou no botão "' + Database + '".');
    NomeDoDatabase := CapturarNomeDoDatabase(NomeDoDatabase, Criar, Digitou);
    if not Digitou then
    begin
      RegistrarLogs('TGerenciadorBackup.BtnNovoDataBaseClick', 'Usuário cancelou a operação.');
      exit;
    end
    else
    begin
      repeat
      begin
        NomeExiste := ValidarExisteDatabase(NomeDoDatabase);
        if NomeExiste then
        begin
          RegistrarLogs('TGerenciadorBackup.BtnNovoDataBaseClick', 'Usuário digitou o database "' + NomeDoDatabase + ' que já existe.');
          MessageDlg('Já existe um database com o nome "' + NomeDoDatabase + '", digite um nome diferente', mtInformation, [mbOK], 0);

          NomeDoDatabase := CapturarNomeDoDatabase(NomeDoDatabase, Criar, Digitou);
          if not Digitou then
          begin
            RegistrarLogs('TGerenciadorBackup.BtnNovoDataBaseClick', 'Novamente o usuário cancelou sem digitar o nome do banco.');
            exit;
          end;
        end
      end;
      until not NomeExiste;

      if NomeDoDatabase <> '' then
      begin
        RegistrarLogs('TGerenciadorBackup.BtnNovoDataBaseClick', 'Usuário digitou o nome do banco de dados "' + NomeDoDatabase + '".');
        CriarDroparRoles(NomeDoDatabase, Criar);
        CriarDroparDataBase(NomeDoDatabase, Criar);
        AdicionarOuRemoverPermissoesNosRoles(NomeDoDatabase, Adicionar);
        MessageDlg('Database "' + NomeDoDatabase + '" criado com sucesso', TMsgDlgType.mtInformation, [mbOK], 0);
        AtualizaListaBancos(True);
      end
      else
        RegistrarLogs('TGerenciadorBackup.BtnNovoDataBaseClick', 'Usuário não digitou o nome do banco de dados.');
    end;
  end
  else
  begin
    RegistrarLogs('TGerenciadorBackup.BtnNovoDataBaseClick', 'Função encerrada devido a tentativa de ' +
                  'criar um banco de dados com a versão ' + CurrToStr(VerificaVersaoPostgres(Versao)) +
                  ' que é inferior a versão ' + CurrToStr(FGerenciadorBackup.VersaoMinima) + ' .');
    MessageDlg('O DataManager não cria banco de dados com versão inferior a versão ' +
                CurrToStr(FGerenciadorBackup.VersaoMinima) + ' .', TMsgDlgType.mtWarning, [mbOK], 0);
  end;
  AtualizaListaBancos(True);
end;

procedure TGerenciadorBackup.DefinirParametros(PNomeDoDriverDB, PServer, PPorta, PUsuario, PBiblioteca, PDump, PRestore,
                                               PDatabase, POwnerPadrao, PSenha, PExtensao, PTipoQueryDlg: String; PVersaoMinima: Currency);
// Método que recebe os parâmetros e atribúi na classe.
begin
  Server := PServer;
  Usuario := PUsuario;
  Senha := PSenha;
  Porta := PPorta;
  OwnerPadrao := POwnerPadrao;
  Extensao := 'postgresql';
  TipoQueryDlg := 'Backup PostgreSQL';
  VersaoMinima := PVersaoMinima;

  if PNomeDoDriverDB = 'Firebird 5.0' then
    begin
       Driver := 'FB';
       Biblioteca := 'C:\Program Files\Firebird\Firebird_5_0\fbclient.dll';
    end
  else if (PNomeDoDriverDB = 'PostgreSQL 17') then
    begin
      Driver := 'PG';
      Biblioteca := 'C:\Program Files\PostgreSQL\17\bin\libpq.dll';
      Dump := 'C:\Program Files\PostgreSQL\17\bin\pg_dump.exe';
      Restore := 'C:\Program Files\PostgreSQL\17\bin\pg_restore.exe';
    end;
  RegistrarLogs('TGerenciadorBackup.DefineParametros', 'Parâmetros de conexão definidos.');
end;


destructor TGerenciadorBackup.Destroy;
begin
  FConnection.Free;
  FPgDriver.Free;
  FQuery.Free;
  inherited;
end;

function TGerenciadorBackup.ValidarExisteDatabase(PNomeDoDatabase: String; PLbxDatabases: TListBox): boolean;
//Função que valida se já existe um database com o mesmo nome que o digitado
var
  i: integer;
begin
  for i := 0 to PLbxDatabases.Items.Count - 1 do
    begin
      if PNomeDoDatabase = PLbxDatabases.Items[i] then
      begin
        RegistrarLogs('TFormDataManager.ValidaDatabaseExistente', 'Database "' + PNomeDoDatabase + '" Existe');
        Result := true;
        exit;
      end
    end;
    Result := False;
    RegistrarLogs('TFormDataManager.ValidaDatabaseExistente', 'Database "' + PNomeDoDatabase + '" não existe');
end;

function TGerenciadorBackup.VerificarVersaoPostgres(out PVersaoCompleta: string): Currency;
//Função que retorna a versão do Postgres conectada no momento
Var
  VersaoResumida, VersaoMaiorOuMenor: string;
  PosicaoPonto: Integer;
begin
  FQuery.Close;
  FQuery.sql.Clear;
  FQuery.sql.add('SELECT version()');
  FQuery.Open;
  if not FQuery.IsEmpty then
    PVersaoCompleta := FQuery.Fields[0].AsString
  else
    PVersaoCompleta := '';

  FQuery.Close;
  FQuery.sql.Clear;
  FQuery.sql.add('SHOW server_version');
  FQuery.Open;
  if not FQuery.IsEmpty then
    VersaoResumida := FQuery.Fields[0].AsString
  else
    VersaoResumida := '';

  VersaoMaiorOuMenor := VersaoResumida; // Inicializa com a VersaoResumida

  PosicaoPonto := Pos('.', VersaoResumida); // Encontra o primeiro ponto
  if PosicaoPonto > 0 then
  begin
    PosicaoPonto := Pos('.', VersaoResumida, PosicaoPonto + 1); // Encontra o segundo ponto, começando a busca APÓS o primeiro ponto
    if PosicaoPonto > 0 then
      VersaoMaiorOuMenor := Copy(VersaoResumida, 1, PosicaoPonto - 1) // Se encontrou o segundo ponto, copia a string até ele
    else
      VersaoMaiorOuMenor := VersaoResumida; // Se só tem um ponto ou nenhum, já foi inicializado acima
  end
  else
  begin
    VersaoMaiorOuMenor := VersaoResumida; // Se não há nenhum ponto (ex: "17"), a versão é a string completa
  end;
  VersaoMaiorOuMenor := StringReplace(VersaoMaiorOuMenor, '.', ',', [rfReplaceAll]); //Substitui o ponto pela vírgula

  Result := StrToCurrDef(VersaoMaiorOuMenor , 0); // Converte a string "Major.Minor" para o tipo Currency e retorna na função
  RegistrarLogs('TGerenciadorBackup.VerificaVersaoPostgres', 'Conectado ao banco de dados ' + PVersaoCompleta);
end;

end.
