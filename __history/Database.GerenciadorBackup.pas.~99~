  Mensagem: String;
begin
  Falha := 0;
  try
    Query.close;
    Query.sql.Clear;
    Query.sql.Add('DROP ROLE "' + OwnerPadrao + '" LOGIN PASSWORD ''#abc123#''');
    Query.ExecSQL;
  except
    On E: Exception do
    begin
       Mensagem := 'Não foi possível excluir o role "' + OwnerPadrao + '", ' +
